# Copy to .env and fill in your values before running the app.
DATABASE_URL=postgresql+psycopg://admin:replace-with-password@localhost:5432/enterprise_ai_mentor
POSTGRES_DB=enterprise_ai_mentor
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-strong-database-password
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
CHROMA_PATH=./chroma_db
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_EXPIRE_MINUTES=480
ADMIN_EMAIL=admin@novatech.test
ADMIN_PASSWORD=replace-with-a-strong-admin-password
MAX_UPLOAD_BYTES=10485760

# Frontend (local dev only; Docker build uses docker-compose build args)
VITE_API_URL=http://localhost:8000
